# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hemolink"

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string"
PORT=3001
NODE_ENV=development

# ── Admin credentials ────────────────────────────────────────────────────────
# Generate hash: node -e "const b=require('bcrypt');b.hash('yourpassword',10).then(console.log)"
ADMIN_EMAIL="admin@rbc.gov.rw"
ADMIN_PASSWORD_HASH="$2b$10$examplehashhere"

# ── Frontend URL (for SMS response links) ───────────────────────────────────
FRONTEND_URL="http://localhost:5173"

# ── SMS — Africa's Talking (Rwanda) ─────────────────────────────────────────
# Sign up at https://africastalking.com
# Leave blank in development — SMS will be logged to console instead
AT_API_KEY=""
AT_USERNAME=""
AT_SENDER_ID="HemoLink"
